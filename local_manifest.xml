<?xml version="1.0" encoding="UTF-8"?>
<manifest>

  <!-- Remoto de GitHub (el manifest de AOSP solo define android.googlesource.com) -->
  <remote name="github"
          fetch="https://github.com/"
          revision="master" />

  <!-- Device tree oficial de CyanogenMod para el Galaxy Ace GT-S5830 (cooper).
       Rama "gingerbread". Incluye el kernel prebuilt (zImage), asi que NO
       hace falta compilar kernel ni bajar fuentes del msm7x27. -->
  <project name="CyanogenMod/android_device_samsung_cooper"
           path="device/samsung/cooper"
           remote="github"
           revision="gingerbread" />

  <!-- Blobs propietarios (RIL, camara, GPU adreno200, OMX, wifi...).
       ~13 MB. Alternativa: extraerlos del telefono con extract-files.sh -->
  <project name="TheMuppets/proprietary_vendor_samsung"
           path="vendor/samsung"
           remote="github"
           revision="gingerbread" />

  <!-- hardware/libhardware_legacy de CyanogenMod en vez del de AOSP puro.
       device/samsung/cooper/libaudio/AudioPolicyManager.cpp usa
       STRATEGY_MEDIA_SONIFICATION del enum routing_strategy declarado en
       hardware_legacy/AudioPolicyManagerBase.h. Esa constante existe en el
       fork de CM (verificado) pero no en la version de AOSP puro sincronizada
       por el manifest default en esta rama (error "was not declared in
       this scope"). El device tree de cooper esta escrito contra el arbol de
       CM en general, no contra AOSP puro, asi que reemplazamos este proyecto
       igual que se hizo con dalvik. -->
  <remove-project name="platform/hardware/libhardware_legacy" />
  <project name="CyanogenMod/android_hardware_libhardware_legacy"
           path="hardware/libhardware_legacy"
           remote="github"
           revision="gingerbread" />

  <!-- OPCIONAL: device/common de CM, por si el de AOSP no trae gps_eu_supl.mk.
       Descomentar SOLO si el build se queja de ese archivo. -->
  <!--
  <remove-project name="platform/device/common" />
  <project name="CyanogenMod/android_device_common"
           path="device/common"
           remote="github"
           revision="gingerbread" />
  -->

</manifest>
